    "charterDraft": {
      "sharpenedIdea": "A walk-in and appointment-based barbershop in Austin offering haircuts, beard trims, and hot towel shaves.",
      "mvpDefinition": "A single-location barbershop operating 6 days a week with a booking system (online appointments + phone walk-in support), basic inventory management for supplies and retail products (pomades, beard oils, aftershaves), weekly staff scheduling, and light marketing via Google Business and local social posts. The core service offering is haircuts, beard trims, and traditional hot towel shaves at market rates. No expansion locations, no new service lines beyond these three offerings.",
      "roleTasks": [
        {
          "roleTitle": "Chief of Staff",
          "tasks": [
            "Draft the weekly plan from founder input and team signals",
            "Flag cross-team conflicts (e.g., inventory running low during heavy appointment weeks)"
          ]
        },
        {
          "roleTitle": "CFO",
          "tasks": [
            "Categorize daily expense receipts and flag unusual spending",
            "Build 30-, 60-, and 90-day cash-flow projections and alert when runway is tight",
            "Track all tax deadlines (quarterly estimated taxes, annual returns) and local Austin business license renewals",
            "Summarize staff hours each week and prepare the payroll-run checklist",
            "Monitor the shop's barber licenses, facility permit, and Texas cosmetology/barbering registrations to ensure they stay current and flag renewal deadlines",
            "Compile a weekly summary of haircuts vs. beard trims vs. hot towel shaves with average ticket price to surface upsell opportunities"
          ]
        },
        {
          "roleTitle": "CMO",
          "tasks": [
            "Draft and schedule local social posts promoting haircut specials, events, or new arrival retail products",
            "Keep the Google Business profile listing fresh with updated hours, photos, and keywords",
            "Draft email and SMS promotions to repeat customers highlighting beard trim or hot towel shave specials"
          ]
        },
        {
          "roleTitle": "Ops Lead",
          "tasks": [
            "Manage the staff shift calendar and handle appointment bookings (both online and phone inquiries)",
            "Track supplier and vendor orders (towels, shaving cream, blades, pomades, beard oils, aftershaves) and flag when stock hits reorder points",
            "Draft reorder communications to vendors when inventory dips",
            "Monitor in-store stock levels daily and separate retail products from service supplies",
            "Alert the team when reorder points are reached"
          ]
        },
        {
          "roleTitle": "Support Lead",
          "tasks": [
            "Read and triage all inbound calls, messages, and DMs; tag by urgency and draft replies to routine questions",
            "Detect upset customers or complex cases and package all context for the founder to review before responding",
            "Monitor Google and Yelp reviews for new ratings, draft a personalized reply for each review, and escalate any negative reviews for human sign-off before posting"
          ]
        },
        {
          "roleTitle": "People Lead",
          "tasks": [
            "Draft job posts when the founder signals a hiring need (e.g., hiring a second barber)",
            "Summarize applicants with key qualifications and experience so the founder can screen efficiently"
          ]
        }
      ],
