        {
          "roleTitle": "Chief of Staff",
          "tasks": [
            "Draft a focused weekly plan for the founder each Monday",
            "Flag scheduling conflicts or cross-team blockers before they become problems"
          ]
        },
        {
          "roleTitle": "CFO",
          "tasks": [
            "Create and send client retainer invoices on schedule",
            "Draft polite but firm payment reminders tailored to each client's history",
            "Tag and categorize all business expenses; flag anything unusual",
            "Maintain a rolling 30/60/90-day cash-flow projection and alert the founder if runway looks tight",
            "Track all tax deadlines and prepare a clean handoff packet for the accountant",
            "Monitor Ohio sales-tax filing deadlines for restaurant clients and flag contract red-flags or regulation changes"
          ]
        },
        {
          "roleTitle": "Delivery Lead",
          "tasks": [
            "Reconcile each restaurant client's bank and credit card transactions monthly",
            "Categorize restaurant-specific expenses (food & beverage COGS, labor, delivery fees, POS fees) in each client's books",
