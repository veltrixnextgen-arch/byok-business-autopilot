# Onboarding-only platform inference key (ADR-003). See
# docs/architecture/security-architecture.md.
ANTHROPIC_API_KEY=sk-ant-...

# --- Local stack (docker-compose.yml: `docker compose up -d`) ---
DATABASE_URL=postgres://byok:byok_dev_password@localhost:5432/byok
REDIS_URL=redis://localhost:6379

# --- apps/api ---
PORT=3000
# Generate a real random value for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-only-not-a-real-secret
BETTER_AUTH_URL=http://localhost:3000
# apps/web's origin — must match exactly (scheme + host + port) for
# cross-origin session cookies to work; see apps/api/src/index.ts's CORS
# setup and packages/auth's trustedOrigins.
WEB_ORIGIN=http://localhost:3002

# --- apps/web ---
VITE_API_URL=http://localhost:3000
