# Onboarding-only platform inference key (ADR-003). See
# docs/architecture/security-architecture.md.
ANTHROPIC_API_KEY=sk-ant-...

# --- Local stack (docker-compose.yml: `docker compose up -d`) ---
DATABASE_URL=postgres://byok:byok_dev_password@localhost:5432/byok
REDIS_URL=redis://localhost:6379

# --- apps/api ---
PORT=3000
# Generate a real random value for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-only-not-a-real-secret
BETTER_AUTH_URL=http://localhost:3000
# apps/web's origin — must match exactly (scheme + host + port) for
# cross-origin session cookies to work; see apps/api/src/index.ts's CORS
# setup and packages/auth's trustedOrigins.
WEB_ORIGIN=http://localhost:3002

# --- apps/web ---
VITE_API_URL=http://localhost:3000

# --- Stripe billing (issue #18/ADR-045) — optional, unset by default ---
# All 8 vars below are all-or-nothing: STRIPE_SECRET_KEY present with any
# of the other 4 missing fails the server at boot (readServerConfigFromEnv,
# apps/api/src/server.ts) rather than booting with billing half-configured.
# Leave every one of these unset for local dev — /me/billing/checkout and
# /billing/webhook 503 cleanly, nothing else about the server is affected.
# Real values require an actual Stripe account with the one real plan
# (ADR-057's prices) created as a single Product with three Prices —
# monthly, quarterly, yearly.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_QUARTERLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# --- Staging (STEP 2) ---
# Real values live ONLY in each platform's own secret store — GitHub Actions
# repo secrets (CI-to-platform deploy auth) or Railway's/Vercel's own env
# var stores (app runtime config). Nothing below is a real value; this is a
# map of what exists and where, not a place to put it.
#
# GitHub Actions secrets (.github/workflows/deploy-staging.yml):
#   NEON_DATABASE_URL   - app_user's DIRECT (not pooled/-pooler) connection
#                         string (plain SQL-created role, NOT neon_superuser
#                         — see verifyRlsIsolation.ts). Direct because CI
#                         uses it for migrations, which Neon recommends NOT
#                         running over the pooled connection. The deploy
#                         workflow derives the pooled variant itself for
#                         Railway's own DATABASE_URL (the live app's traffic
#                         is the case pooling is actually for).
#   REDIS_URL           - Upstash Redis (rediss://) connection string
#   RAILWAY_TOKEN       - Railway Project Token, deploy-scoped
#   VERCEL_TOKEN        - Vercel access token
#   VERCEL_ORG_ID       - Vercel team/org id (not sensitive, kept alongside)
#   VERCEL_PROJECT_ID   - Vercel project id (not sensitive, kept alongside)
#
# Railway env vars (set BY the deploy workflow itself, not by hand):
#   DATABASE_URL, REDIS_URL, WEB_ORIGIN, BETTER_AUTH_URL, NODE_ENV=staging,
#   BETTER_AUTH_SECRET and STAGING_KMS_MASTER_KEY (generated fresh per
#   deploy — see StagingKms in packages/vault/src/kms.ts and ADR-007).
